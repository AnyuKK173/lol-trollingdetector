# 从 https://developer.riotgames.com/ 获取；开发 Key 通常会过期，请勿提交真实 Key。
RIOT_API_KEY=RGAPI-replace-me

# 平台路由：NA1/EUW1/KR 等；区域路由通常为 AMERICAS/EUROPE/ASIA/SEA。
RIOT_PLATFORM=NA1
RIOT_REGION=AMERICAS

DATABASE_URL=postgresql://riot:riot@localhost:5432/riot_gold
RAW_DIR=./raw_samples

# 保守限速；生产 Key 可按批准后的限额调整。
REQUEST_INTERVAL_SECONDS=1.25
MAX_RETRIES=5

# 锁定单一 patch，避免基线曲线混入不同版本的经济数据。
# 这里的 16.14 只是示例，不要当成永久默认值——每次开采新版本都要改。
TARGET_PATCH=16.14
TARGET_QUEUE_ID=420
# 目标是"有效验证过的比赛数"，不是玩家数；已完成的会被计入，不用从零算。
TARGET_VERIFIED_MATCHES=500
# 可选：patch 上线时间（ISO8601），只用于减少 Match ID 查询的无效请求，
# 不保证版本一致——真正的过滤靠 Match Detail 里的 gameVersion 硬校验。
TARGET_PATCH_START=2026-07-13T00:00:00Z

# 段位快照与比赛实际发生时间之间允许的最大天数差，超过视为漂移过大而跳过。
MAX_RANK_AGE_DAYS=21
# 采集主循环超过这么多秒没有任何进展（拉取/写库/跳过）就打一条 WARNING。
NO_PROGRESS_WARNING_SECONDS=300
